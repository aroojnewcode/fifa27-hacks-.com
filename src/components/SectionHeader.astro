---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
  as?: 'h1' | 'h2';
}

const { eyebrow, title, desc, titleId, centered = false, wide = false, as: Heading = 'h2' } = Astro.props;
---

<header class:list={['section-header space-y-0', wide && 'section-header--wide', centered && 'mx-auto text-center']}>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <Heading id={titleId} class="section-header__title">{title}</Heading>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
