---
import { t } from '../i18n';
import { localePath } from '../i18n/paths';
import { checkoutPath } from '../config/checkout';
import { checkoutLinkAttrs } from '../utils/path';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { Button } from '@/components/starwind/button';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from '@/components/starwind/sheet';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';

import type { IconName } from './icons/types';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const navIconsByHref: Record<string, IconName> = {
  '/': 'appWindow',
  '/products/fifa-27-hacks/': 'navProducts',
  '/blog/': 'navBlog',
  '/forum/': 'messageCircle',
  '/faq/': 'navFaq',
  '/support/': 'navSupport',
};

const purchaseUrl = checkoutPath('fifa27');
const purchaseLink = checkoutLinkAttrs(purchaseUrl);
const homeHref = localePath('/', locale);
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="pointer-events-auto relative flex h-14 w-full max-w-6xl items-center justify-between gap-2 rounded-2xl border border-border/40 bg-background/35 px-4 text-foreground shadow-md shadow-black/5 backdrop-blur-2xl supports-[backdrop-filter]:bg-background/25 dark:border-white/10 dark:bg-background/20 dark:shadow-black/25 sm:px-5 lg:grid lg:h-[3.75rem] lg:grid-cols-[minmax(0,1fr)_auto_minmax(15rem,1.15fr)] lg:items-center lg:gap-x-8 xl:grid-cols-[minmax(0,1fr)_auto_minmax(17rem,1.2fr)] xl:gap-x-10"
    >
    <a
      href={homeHref}
      class="inline-flex min-w-0 shrink-0 items-center font-[family-name:var(--font-heading)] text-lg font-bold tracking-wide lg:justify-self-start"
    >
      <span class="truncate">EA FC 27<span class="text-primary">Cheats</span></span>
    </a>

    <nav
      class="hidden min-w-0 max-w-full items-center justify-center gap-2 px-1 lg:col-start-2 lg:flex lg:gap-2.5 lg:pr-12 xl:gap-3 xl:pr-16 2xl:pr-20"
      aria-label="Primary"
    >
      {t.nav.map((link) => (
        <a
          href={localePath(link.href, locale)}
          class="nav-link inline-flex shrink-0 items-center gap-1 whitespace-nowrap text-xs font-medium text-foreground/90 transition-colors hover:text-primary xl:gap-1.5 xl:text-sm"
          data-nav-link
          {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
        >
          <Icon name={navIconsByHref[link.href] ?? 'navFeatures'} size={16} class="hidden xl:block" />
          {link.label}
        </a>
      ))}
    </nav>

    <div
      class="flex shrink-0 items-center justify-end gap-2.5 lg:col-start-3 lg:justify-self-end lg:gap-3 lg:border-l lg:border-border/50 lg:pl-8 lg:ml-4 xl:pl-10 xl:ml-5"
    >
      <LanguageSwitcher
        locale={locale}
        class="relative z-20 ms-1 shrink-0 rounded-lg bg-background/70 ring-1 ring-border/40 sm:ms-2 lg:ms-3 lg:min-w-[8.25rem] xl:min-w-[9rem]"
      />
      <div class="hidden items-center sm:flex">
        <SlideRevealButton href={purchaseUrl} class="hidden lg:inline-flex" ariaLabel={t.ui.checkoutAria}>
          {t.ui.browseCheats}
        </SlideRevealButton>
        <div class="nav-action-divider hidden items-center px-3 lg:flex" aria-hidden="true">
          <span class="block h-9 w-px bg-border"></span>
        </div>
        <AnimatedThemeSwitch size="md" ariaLabel={t.ui.themeLight} class="inline-flex" />
      </div>

      <Sheet class="lg:hidden">
        <SheetTrigger
          class="inline-flex size-9 items-center justify-center rounded-lg border border-border/80 bg-background/50 text-foreground transition-colors hover:bg-muted lg:hidden"
          aria-label={t.ui.menuOpen}
        >
          <Icon name="menu" size={20} />
        </SheetTrigger>
        <SheetContent side="right" class="flex w-[min(100vw-2rem,20rem)] flex-col gap-4">
          <SheetHeader>
            <SheetTitle>{t.site.name}</SheetTitle>
          </SheetHeader>
          <nav class="flex flex-col gap-1" aria-label="Mobile">
            {t.nav.map((link) => (
              <a
                href={localePath(link.href, locale)}
                class="nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-foreground/90 transition-colors hover:bg-muted hover:text-primary"
                data-nav-link
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                <Icon name={navIconsByHref[link.href] ?? 'navFeatures'} size={16} />
                {link.label}
              </a>
            ))}
          </nav>
          <Button as="a" href={purchaseUrl} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria} {...purchaseLink}>
            {t.ui.browseCheatsMobile}
          </Button>
          <div class="flex justify-center pt-1">
            <AnimatedThemeSwitch size="sm" ariaLabel={t.ui.themeLight} />
          </div>
        </SheetContent>
      </Sheet>
    </div>
    </div>
  </div>
</header>
