---
import { setActiveLocale } from '../i18n/active';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { resolvePageSeo, DEFAULT_OG_IMAGE } from '../config/seo';
import { faqPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
import { heroSlides } from '../data/products';
import { webpSrc } from '../utils/responsiveImage';

/** Production: single canonical English home at `/en/`. Dev keeps `/` for localhost. */
if (import.meta.env.PROD) {
  return Astro.redirect('/en/', 301);
}

setActiveLocale('en');
const locale = 'en';
const seo = resolvePageSeo('/en/');
const homeFaqs = getLandingFaqs();
const heroLcpImage = webpSrc('/images/gameplay/fifa-27-pitch-overlay.png', 512);
---

<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  ogImage={DEFAULT_OG_IMAGE}
  ogImageAlt={heroSlides[0]?.alt ?? seo.title}
  jsonLd={[websiteSchema(), organizationSchema(), faqPageSchema(homeFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
