---
import { localeStaticPaths, initLocalePage } from '../../i18n/page';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import Icon from '../../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';
import { localePath } from '../../i18n/paths';

export const getStaticPaths = localeStaticPaths;

const locale = initLocalePage(Astro);
const homeHref = localePath(ROUTES.home, locale);
---

<BaseLayout locale={locale}
  title={`Page not found | ${t.site.name}`}
  description="The page you requested could not be found on fifa27hacks.com."
  noindex={true}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-lg px-5 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Page not found</h1>
      <p class="mt-4 text-muted-foreground">That URL is not on fifa27hacks.com. Try the homepage or use the menu.</p>
      <Button as="a" href={homeHref} variant="primary" class="mt-8 rounded-xl">
        <Icon name="appWindow" size={18} />
        Back to home
      </Button>
    </div>
  </section>
</BaseLayout>
