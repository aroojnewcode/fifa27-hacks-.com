---
import { initLocalePage, pathsWithLocale } from '../../../i18n/page';
import '../../../styles/blog-pages.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { getAllBlogSlugs, getRelatedBlogPosts } from '../../../data/blog';
import { getLocalizedBlogPost } from '../../../data/blog/locale';
import { getLocaleContent } from '../../../i18n/fullLocales';
import { blogPostDocumentTitle, cheatMetaDescription, SITE_ORIGIN } from '../../../config/seo';
import { DEFAULT_LOCALE } from '../../../i18n/locales';
import { localePath } from '../../../i18n/paths';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../../config/checkout';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../../data/faq';
import SiteFaqSection from '../../../components/SiteFaqSection.astro';
import Icon from '../../../components/icons/Icon.astro';
import type { BlogBlock } from '../../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../../components/BlogPostCta.astro';
import { blogImageAlt } from '../../../data/blog/blogImageAlt';
import { checkoutLinkAttrs, localizedHref, ROUTES } from '../../../utils/path';

export function getStaticPaths() {
  return pathsWithLocale(() => getAllBlogSlugs().map((slug) => ({ slug })));
}

const locale = initLocalePage(Astro);
const { slug } = Astro.params;
const post = getLocalizedBlogPost(slug!, locale);
if (!post) {
  return Astro.redirect(localePath('/blog/', locale));
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: t.ui.breadcrumbHome, path: '/' },
  { name: t.ui.breadcrumbBlog, path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);

function contentHref(href: string): string {
  const resolved = resolveCheckoutHref(href);
  if (resolved.startsWith('http')) return resolved;
  return localizedHref(resolved, locale);
}

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      return `<a href="${contentHref(href)}">${label}</a>`;
    })
    .replace(/(https:\/\/fifa27hacks\.com[^\s.,;)]*)/g, (_match, url: string) => {
      const path = url.replace(/^https:\/\/fifa27hacks\.com/, '') || '/';
      return `<a href="${contentHref(path)}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const documentTitle = blogPostDocumentTitle(post);
const hasBlogTranslation = Boolean(getLocaleContent(locale)?.blog?.[post.slug]?.title);
const blogArticleNoindex = locale !== DEFAULT_LOCALE && !hasBlogTranslation;
const blogHreflangLinks = blogArticleNoindex
  ? []
  : [
      { hreflang: 'en', href: `${SITE_ORIGIN}${localePath(postPath, DEFAULT_LOCALE)}` },
      ...(hasBlogTranslation
        ? [{ hreflang: locale, href: `${SITE_ORIGIN}${localePath(postPath, locale)}` }]
        : []),
    ];
---

<BaseLayout locale={locale}
  title={documentTitle}
  description={cheatMetaDescription(post.desc)}
  noindex={blogArticleNoindex}
  hreflangLinks={blogArticleNoindex ? [] : blogHreflangLinks}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={blogImageAlt(post)}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: cheatMetaDescription(post.desc),
      url: postPath,
      image: post.image,
      datePublished: published,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} locale={locale} />

      <BlogPostTopBar post={post} class="mt-6" />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <BlogSidebar post={post} related={related} class="order-2 lg:order-1" />

        <div class="order-1 min-w-0 lg:order-2">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={blogImageAlt(post)}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{post.title}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={resolveCheckoutHref(block.href)}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={checkoutPath('fifa27')} variant="primary" aria-label={t.ui.checkoutAria} {...checkoutLinkAttrs(checkoutPath('fifa27'))}>
              Buy EA FC 27 Hacks & Cheats
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={localizedHref(ROUTES.products, locale)} variant="outline">
              View products
            </Button>
            <Button as="a" href={localizedHref(ROUTES.blog, locale)} variant="outline">
              More articles
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={getBlogFaqs(post.tag, post.slug)}
    titleId={`blog-faq-${post.slug}`}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
