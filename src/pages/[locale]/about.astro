---
import { localeStaticPaths, initLocalePage } from '../../i18n/page';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import LegalPage from '../../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../../utils/schema';

export const getStaticPaths = localeStaticPaths;

const locale = initLocalePage(Astro);
const seo = resolvePageSeo(Astro.url.pathname);
const content = t.legalPages.about;
---

<BaseLayout locale={locale}
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: content.title,
      description: content.description,
      url: '/about/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: content.title, path: '/about/' },
    ]),
  ]}
>
  <LegalPage content={content} locale={locale} />
</BaseLayout>
