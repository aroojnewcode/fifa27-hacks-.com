---
import { localeStaticPaths, initLocalePage } from '../../i18n/page';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import WhySetupSection from '../../components/WhySetupSection.astro';
import ProductsSection from '../../components/ProductsSection.astro';
import ContentSections from '../../components/ContentSections.astro';
import { resolvePageSeo } from '../../config/seo';
import { faqPageSchema, organizationSchema, websiteSchema } from '../../utils/schema';
import { getLandingFaqsForLocale } from '../../data/faq/locale';
import { heroSlides } from '../../data/products';
import { webpSrc } from '../../utils/responsiveImage';
import { DEFAULT_OG_IMAGE } from '../../config/seo';

export const getStaticPaths = localeStaticPaths;

const locale = initLocalePage(Astro);

const seo = resolvePageSeo(Astro.url.pathname);
const homeFaqs = getLandingFaqsForLocale(locale);
const heroLcpImage = webpSrc('/images/gameplay/fifa-27-pitch-overlay.png', 512);
---

<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  ogImage={DEFAULT_OG_IMAGE}
  ogImageAlt={heroSlides[0]?.alt ?? seo.title}
  jsonLd={[websiteSchema(), organizationSchema(), faqPageSchema(homeFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
